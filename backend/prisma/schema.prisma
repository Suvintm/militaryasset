generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BASE_COMMANDER
  LOGISTICS_OFFICER
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  passwordHash       String         @map("password_hash")
  role               Role           @default(LOGISTICS_OFFICER)
  baseId             String?        @map("base_id")
  base               Base?          @relation(fields: [baseId], references: [id])
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  purchases          Purchase[]
  transfersInitiated Transfer[]     @relation("initiatedBy")
  transfersApproved  Transfer[]     @relation("approvedBy")
  assignments        Assignment[]
  expenditures       Expenditure[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

model Base {
  id            String         @id @default(uuid())
  name          String         @unique
  location      String
  createdAt     DateTime       @default(now()) @map("created_at")
  users         User[]
  stockBalances StockBalance[]
  purchases     Purchase[]
  transfersOut  Transfer[]     @relation("fromBase")
  transfersIn   Transfer[]     @relation("toBase")
  assignments   Assignment[]
  expenditures  Expenditure[]

  @@map("bases")
}

model EquipmentType {
  id           String         @id @default(uuid())
  name         String         @unique
  category     String
  unit         String         @default("units")
  stocks       StockBalance[]
  purchases    Purchase[]
  transfers    Transfer[]
  assignments  Assignment[]
  expenditures Expenditure[]

  @@map("equipment_types")
}

model StockBalance {
  id              String        @id @default(uuid())
  baseId          String        @map("base_id")
  base            Base          @relation(fields: [baseId], references: [id])
  equipmentTypeId String        @map("equipment_type_id")
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int           @default(0)
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([baseId, equipmentTypeId])
  @@map("stock_balances")
}

model Purchase {
  id              String        @id @default(uuid())
  baseId          String        @map("base_id")
  base            Base          @relation(fields: [baseId], references: [id])
  equipmentTypeId String        @map("equipment_type_id")
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  supplier        String
  purchaseDate    DateTime      @map("purchase_date")
  notes           String?
  recordedById    String        @map("recorded_by_id")
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("purchases")
}

model Transfer {
  id              String          @id @default(uuid())
  fromBaseId      String          @map("from_base_id")
  fromBase        Base            @relation("fromBase", fields: [fromBaseId], references: [id])
  toBaseId        String          @map("to_base_id")
  toBase          Base            @relation("toBase", fields: [toBaseId], references: [id])
  equipmentTypeId String          @map("equipment_type_id")
  equipmentType   EquipmentType   @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int
  status          TransferStatus  @default(PENDING)
  notes           String?
  initiatedById   String          @map("initiated_by_id")
  initiatedBy     User            @relation("initiatedBy", fields: [initiatedById], references: [id])
  approvedById    String?         @map("approved_by_id")
  approvedBy      User?           @relation("approvedBy", fields: [approvedById], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  completedAt     DateTime?       @map("completed_at")
  events          TransferEvent[]

  @@map("transfers")
}

model TransferEvent {
  id         String         @id @default(uuid())
  transferId String         @map("transfer_id")
  transfer   Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  status     TransferStatus
  note       String?
  actorId    String?        @map("actor_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@map("transfer_events")
}

model Assignment {
  id              String           @id @default(uuid())
  baseId          String           @map("base_id")
  base            Base             @relation(fields: [baseId], references: [id])
  equipmentTypeId String           @map("equipment_type_id")
  equipmentType   EquipmentType    @relation(fields: [equipmentTypeId], references: [id])
  personnelName   String           @map("personnel_name")
  personnelId     String           @map("personnel_id")
  quantity        Int
  status          AssignmentStatus @default(ACTIVE)
  assignedById    String           @map("assigned_by_id")
  assignedBy      User             @relation(fields: [assignedById], references: [id])
  assignedAt      DateTime         @default(now()) @map("assigned_at")
  returnedAt      DateTime?        @map("returned_at")
  notes           String?

  @@map("assignments")
}

model Expenditure {
  id              String        @id @default(uuid())
  baseId          String        @map("base_id")
  base            Base          @relation(fields: [baseId], references: [id])
  equipmentTypeId String        @map("equipment_type_id")
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int
  reason          String
  expendedById    String        @map("expended_by_id")
  expendedBy      User          @relation(fields: [expendedById], references: [id])
  expendedAt      DateTime      @default(now()) @map("expended_at")

  @@map("expenditures")
}

model AuditLog {
  id            String      @id @default(uuid())
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id])
  action        AuditAction
  entityType    String      @map("entity_type")
  entityId      String?     @map("entity_id")
  method        String?
  path          String?
  ip            String?
  userAgent     String?     @map("user_agent")
  payloadBefore Json?       @map("payload_before")
  payloadAfter  Json?       @map("payload_after")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
