PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------------------------------
# Paste your Neon PostgreSQL connection string into NEON_DATABASE_URL below.
# Example: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# If NEON_DATABASE_URL is left empty, MAMS automatically connects to local Docker PostgreSQL.
NEON_DATABASE_URL=

# Local Docker fallback connection string
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mams_db?schema=public

JWT_SECRET=mams_super_secret_jwt_access_key_2026
JWT_REFRESH_SECRET=mams_super_secret_jwt_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
